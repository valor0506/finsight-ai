# FinSight AI — Backend Environment Configuration Example

# App Setup
ENVIRONMENT=production                       # "development" | "production"
FRONTEND_URL=https://your-frontend.vercel.app # CORS allowed origin
SECRET_KEY=generate_a_secure_random_key_here  # JWT signing key
ACCESS_TOKEN_EXPIRE_MINUTES=10080             # 7 days

# LLM Layer (OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Data Provider API Keys
NEWS_API_KEY=your_news_api_key_here
FRED_API_KEY=your_fred_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here
GROWW_API_KEY=your_groww_totp_key_here
GROWW_TOTP_SECRET=your_groww_totp_secret_here

# Postgres Database (Supabase)
# Note: Can be postgresql:// or postgresql+asyncpg:// — database.py normalizes automatically.
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# Supabase Client Credentials
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# Upstash Redis Broker & Cache
REDIS_URL=rediss://default:password@xxxx.upstash.io:6379
